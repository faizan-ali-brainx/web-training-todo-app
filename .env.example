# Auth and Todos are both live against the real NestJS backend.
# Set either to "true" to fall back to that feature's mock API.
VITE_USE_MOCK_AUTH_API=false
# Governs todos, collaboration, AND notifications (same Todo domain/backend).
# In mock mode there's no real-time WebSocket — notifications still list, but
# aren't pushed live.
VITE_USE_MOCK_TODOS_API=false

# Base URL of the real backend API (only used when a flag above is "false").
# The Part 3 notifications WebSocket connects to this URL's origin (the part
# before /api/v1), so keep the origin correct here.
VITE_API_BASE_URL=http://localhost:3000/api/v1
